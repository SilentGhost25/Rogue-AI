<Application x:Class="LabKiosk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#E6EEF2"/>
        <SolidColorBrush x:Key="Panel" Color="#16262F"/>
        <SolidColorBrush x:Key="Line" Color="#26404D"/>
        <SolidColorBrush x:Key="Alert" Color="#E5533D"/>
        <SolidColorBrush x:Key="Ok" Color="#3FB68B"/>
        <SolidColorBrush x:Key="Mute" Color="#8AA0AC"/>
        <SolidColorBrush x:Key="Cyan" Color="#37D6E8"/>
        <SolidColorBrush x:Key="Warn" Color="#E0B341"/>
    </Application.Resources>
</Application>
