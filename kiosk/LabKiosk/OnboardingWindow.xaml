<Window x:Class="LabKiosk.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROGUE AI: Participant Setup"
        Width="680" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#080E13"
        BorderBrush="#37D6E8"
        BorderThickness="2"
        ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0F1E27"/>
        <SolidColorBrush x:Key="Line" Color="#1B3848"/>
        <SolidColorBrush x:Key="Cyan" Color="#37D6E8"/>
        <SolidColorBrush x:Key="Ok" Color="#3FB68B"/>
        <SolidColorBrush x:Key="Alert" Color="#E5533D"/>
        <SolidColorBrush x:Key="Ink" Color="#E6EEF2"/>
        <SolidColorBrush x:Key="Mute" Color="#8AA0AC"/>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1B3848"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#255169"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button">
            <Setter Property="Background" Value="#13523B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ok}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1C7554"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#14242E"/>
            <Setter Property="Foreground" Value="#E6EEF2"/>
            <Setter Property="BorderBrush" Value="#26404D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="*"/>    <!-- Setup Cards -->
                <RowDefinition Height="Auto"/> <!-- Action Row -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <DockPanel>
                    <TextBlock Text="ROGUE AI: THE BREACH PROTOCOL" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="18"/>
                    <Button Content="✕" Click="OnCloseClick" Width="26" Height="26" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Padding="0"/>
                </DockPanel>
                <TextBlock Text="Participant Terminal Setup &amp; Account Authorization" Foreground="{StaticResource Mute}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Step 1: Google Account -->
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="1. Antigravity AI (Google Account)" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="14"/>
                                <Border x:Name="BadgeGoogle" HorizontalAlignment="Right" Background="#1D2A1F" BorderBrush="{StaticResource Ok}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                    <TextBlock x:Name="TxtGoogleStatus" Text="⏳ Not Connected" Foreground="{StaticResource Mute}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="Sign in to your Google Account to authorize Gemini AI in the Antigravity CLI terminal." Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10"/>
                            <DockPanel>
                                <Button x:Name="BtnGoogleLogin" Content="🌐 Sign In with Google" Click="OnGoogleLoginClick" Style="{StaticResource PrimaryBtn}" Padding="14,6" FontSize="12" DockPanel.Dock="Left"/>
                                <TextBox x:Name="TxtGoogleEmail" Text="" Margin="12,0,0,0" Style="{StaticResource InputBox}" IsReadOnly="True" ToolTip="Connected Google email address"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Step 2: GitHub Account -->
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="2. GitHub Identity &amp; Repository Linking" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="14"/>
                                <Border x:Name="BadgeGithub" HorizontalAlignment="Right" Background="#1D2A1F" BorderBrush="{StaticResource Ok}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                    <TextBlock x:Name="TxtGithubStatus" Text="⏳ Not Connected" Foreground="{StaticResource Mute}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="Connect your GitHub profile or enter your verified username to link your workspace." Foreground="{StaticResource Mute}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnGithubDevice" Content="🐙 Connect GitHub" Click="OnGithubDeviceClick" Style="{StaticResource PrimaryBtn}" Padding="14,6" FontSize="12" Grid.Column="0"/>
                                <TextBox x:Name="TxtGithubHandle" Text="" Margin="10,0,10,0" Style="{StaticResource InputBox}" Grid.Column="1" TextChanged="OnHandleChanged"/>
                                <Button Content="Verify Handle" Click="OnVerifyGithubClick" Style="{StaticResource PrimaryBtn}" Padding="12,6" FontSize="12" Grid.Column="2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Step 3: Leaderboard Handle -->
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="3. Leaderboard Display Name" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Text="This is the username that will identify your kiosk on the live projector and command center." Foreground="{StaticResource Mute}" FontSize="12" Margin="0,0,0,8"/>
                            <TextBox x:Name="TxtDisplayName" Style="{StaticResource InputBox}" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 4: Event Server Connection -->
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="4. Organizer Station Connection" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock x:Name="TxtServerStatus" Text="" Foreground="{StaticResource Ok}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="Ensure this matches the physical LAN IP shown on the Organizer's Command Center." Foreground="{StaticResource Mute}" FontSize="12" Margin="0,4,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtServerUrl" Style="{StaticResource InputBox}" Grid.Column="0" Margin="0,0,10,0"/>
                                <Button Content="Test Link" Click="OnTestServerClick" Style="{StaticResource PrimaryBtn}" Padding="14,6" FontSize="12" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Row -->
            <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock x:Name="TxtWarning" Text="" Foreground="{StaticResource Alert}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                <Button x:Name="BtnLaunch" Content="🚀 Launch Breach Protocol" Click="OnLaunchClick" Style="{StaticResource SuccessBtn}" Padding="24,10" HorizontalAlignment="Right"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>

