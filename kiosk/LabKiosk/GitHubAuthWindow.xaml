<Window x:Class="LabKiosk.GitHubAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GitHub Account Authorization"
        Width="640" Height="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#080E13"
        BorderBrush="#37D6E8"
        BorderThickness="2"
        ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0F1E27"/>
        <SolidColorBrush x:Key="Line" Color="#1B3848"/>
        <SolidColorBrush x:Key="Cyan" Color="#37D6E8"/>
        <SolidColorBrush x:Key="Ok" Color="#3FB68B"/>
        <SolidColorBrush x:Key="Alert" Color="#E5533D"/>
        <SolidColorBrush x:Key="Ink" Color="#E6EEF2"/>
        <SolidColorBrush x:Key="Mute" Color="#8AA0AC"/>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="#1B3848"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#255169"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title bar -->
            <RowDefinition Height="*"/>    <!-- WebView2 container -->
            <RowDefinition Height="Auto"/> <!-- Status footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Button Content="✕" Click="OnCancelClick" Width="26" Height="26" Style="{StaticResource CloseBtn}" DockPanel.Dock="Right" Padding="0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GITHUB IDENTITY AUTHORIZATION" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="Sign in to your GitHub account. Your username will be linked automatically." Foreground="{StaticResource Mute}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Browser Container -->
        <Grid Grid.Row="1" Background="#0A141C">
            <wv2:WebView2 x:Name="AuthBrowser"/>
            <Border x:Name="LoadingOverlay" Background="#E6080E13" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLoading" Text="Loading GitHub Login..." Foreground="{StaticResource Cyan}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please wait while the secure browser session initializes." Foreground="{StaticResource Mute}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" Text="Awaiting GitHub sign in..." Foreground="{StaticResource Mute}" FontSize="11" VerticalAlignment="Center"/>
                <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource CloseBtn}" Padding="14,4" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

