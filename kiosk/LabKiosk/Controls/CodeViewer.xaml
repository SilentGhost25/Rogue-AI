<UserControl x:Class="LabKiosk.Controls.CodeViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="#0A1218" Foreground="{StaticResource Ink}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" MinWidth="120" MaxWidth="300"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: File Explorer sidebar -->
        <Border Grid.Column="0" Background="#0E1A22" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="⟳" Width="24" Height="22" Padding="0" Click="OnRefreshTree"
                                Background="Transparent" Foreground="{StaticResource Mute}" BorderThickness="0"
                                ToolTip="Refresh file tree"/>
                        <TextBlock Text="WORKSPACE" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Mute}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}"
                         SelectionChanged="OnFileSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                <TextBlock Text="{Binding Icon}" Width="16" Foreground="{Binding IconColor}" Margin="0,0,4,0" FontSize="11"/>
                                <TextBlock Text="{Binding DisplayPath}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

        <!-- Right: Code Editor & Viewer -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Editor Header -->
            <Border Grid.Row="0" Background="#16262F" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SyncStatus" Text="Synced" FontSize="11" Foreground="{StaticResource Ok}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button x:Name="SaveButton" Content="Save (Ctrl+S)" Padding="10,3" FontSize="11" Click="OnSaveClicked"
                                Background="#1E3340" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}"/>
                    </StackPanel>
                    <TextBlock x:Name="CurrentFilePath" Text="Select a file from the explorer" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- AvalonEdit Code Area -->
            <avalonEdit:TextEditor x:Name="Editor" Grid.Row="1"
                                   Background="#0A1218" Foreground="#E6EEF2"
                                   FontFamily="Consolas" FontSize="13"
                                   ShowLineNumbers="True"
                                   LineNumbersForeground="#506673"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </Grid>
</UserControl>

