<Window x:Class="LabKiosk.ServerConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control Plane Server Settings"
        Height="320" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#0E1A22" Foreground="{StaticResource Ink}"
        BorderBrush="{StaticResource Line}" BorderThickness="1"
        ShowInTaskbar="False" WindowStyle="ToolWindow" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙ Organizer Server Connection" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="Enter the IP address or URL displayed on the Organizer host screen." FontSize="12" Foreground="{StaticResource Mute}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Organizer Host URL / IP:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
            <TextBox x:Name="ServerUrlBox" Background="#070E13" Foreground="#FFFFFF" BorderBrush="{StaticResource Line}" Padding="8,6" FontSize="13" FontFamily="Consolas, monospace"/>
            <TextBlock Text="Example: http://192.168.0.82:5080" FontSize="10" Foreground="{StaticResource Mute}" Margin="2,4,0,10"/>

            <TextBlock Text="Participant Desk ID:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
            <TextBox x:Name="DeskIdBox" Background="#070E13" Foreground="#FFFFFF" BorderBrush="{StaticResource Line}" Padding="8,6" FontSize="13" FontFamily="Consolas, monospace"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="🔍 Auto-Detect on LAN" Padding="14,6" Margin="0,0,10,0" Click="OnAutoDetect" Background="#162733" Foreground="#1E90FF" BorderBrush="#1E90FF" BorderThickness="1"/>
            <Button Content="Cancel" Padding="16,6" Margin="0,0,10,0" Click="OnCancel" Background="#1E3340" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}"/>
            <Button Content="Connect &amp; Save" Padding="18,6" Click="OnSave" Background="#163140" Foreground="#2ED573" BorderBrush="#2ED573" BorderThickness="1" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>

