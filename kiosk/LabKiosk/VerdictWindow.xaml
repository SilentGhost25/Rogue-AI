<Window x:Class="LabKiosk.VerdictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Breach Evaluation Result"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#BF000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="OnKeyDown"
        MouseDown="OnBackdropMouseDown">
    <Window.Resources>
        <Style x:Key="DialogPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1B3848"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#37D6E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#255169"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogNeutralBtn" TargetType="Button">
            <Setter Property="Background" Value="#14242E"/>
            <Setter Property="Foreground" Value="#E6EEF2"/>
            <Setter Property="BorderBrush" Value="#26404D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#37D6E8"/>
                                <Setter TargetName="b" Property="Background" Value="#1D3544"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="CardBorder" Background="#0C171F" BorderBrush="#00E676" BorderThickness="2" CornerRadius="8"
                Width="660" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26"
                MouseDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect x:Name="CardGlow" Color="#00E676" BlurRadius="40" ShadowDepth="0" Opacity="0.85"/>
            </Border.Effect>
            <StackPanel>
                <!-- Title Row -->
                <DockPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtIcon" Text="🏆 " FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeading" Text="OPTIMAL SOLUTION ACCEPTED" Foreground="#00E676" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Click="OnDismissClick" DockPanel.Dock="Right" Width="28" Height="28"
                            Style="{StaticResource DialogNeutralBtn}" HorizontalAlignment="Right" Padding="0" Cursor="Hand"/>
                </DockPanel>

                <!-- Intrusion Meta Box -->
                <Border Background="#13232D" BorderBrush="#26404D" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Attack Title & Points -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock x:Name="TxtAttackTitle" Text="Attack #3: Hydra Query" Foreground="#E6EEF2" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtScoreBadge" Text="+9,500 PTS" Foreground="#00E676" FontWeight="Bold" FontSize="16" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Classification Badge -->
                        <Border x:Name="TierBadgeBorder" Background="#152B1E" BorderBrush="#00E676" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,14">
                            <TextBlock x:Name="TxtTierLabel" Text="MAXIMUM EFFICIENCY · 100% QUALITY SCORE" Foreground="#00E676" FontSize="11" FontWeight="Bold"/>
                        </Border>

                        <!-- Evaluation Feedback Headline -->
                        <TextBlock x:Name="TxtSubheadline" Text="All exploit checks passed. Clean architectural implementation." Foreground="#E6EEF2" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"/>

                        <!-- Detailed Diagnostic / Criteria Box -->
                        <TextBlock Text="EVALUATION VERDICT &amp; DIAGNOSTICS:" Foreground="#8AA0AC" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                        <Border x:Name="DiagnosticsBorder" Background="#0A141A" BorderBrush="#1B313F" BorderThickness="1" CornerRadius="4" Padding="12,10">
                            <TextBlock x:Name="TxtDiagnostics" Text="Exploit neutralized. Non-regression green. Response latency within SLA." Foreground="#A6BAC7" FontSize="12" FontFamily="Consolas, monospace" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <DockPanel>
                    <Button x:Name="BtnAction" Content="✓ Continue Defense" Click="OnDismissClick"
                            Style="{StaticResource DialogPrimaryBtn}" Padding="24,10" FontSize="13" DockPanel.Dock="Left" Cursor="Hand"/>
                    <Button Content="Close (Esc)" Click="OnDismissClick"
                            Style="{StaticResource DialogNeutralBtn}" Padding="16,9" FontSize="12" HorizontalAlignment="Right" Cursor="Hand"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

