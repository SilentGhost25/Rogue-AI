<Window x:Class="LabKiosk.EvaluationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AEGIS Tactical Evaluation Dossier"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#BF000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="OnKeyDown"
        MouseDown="OnBackdropMouseDown">
    <Window.Resources>
        <Style x:Key="DialogPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1B3848"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#37D6E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#255169"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogNeutralBtn" TargetType="Button">
            <Setter Property="Background" Value="#14242E"/>
            <Setter Property="Foreground" Value="#E6EEF2"/>
            <Setter Property="BorderBrush" Value="#26404D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#37D6E8"/>
                                <Setter TargetName="b" Property="Background" Value="#1D3544"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="CardBorder" Background="#0C171F" BorderBrush="#3FB68B" BorderThickness="2" CornerRadius="8"
                Width="660" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26"
                MouseDown="OnCardMouseDown">
            <Border.Effect>
                <DropShadowEffect x:Name="CardGlow" Color="#3FB68B" BlurRadius="35" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <StackPanel>
                <!-- Title Row -->
                <DockPanel Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️ " FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeader" Text="AEGIS EVALUATION DOSSIER" Foreground="#37D6E8" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Click="OnDismissClick" DockPanel.Dock="Right" Width="28" Height="28"
                            Style="{StaticResource DialogNeutralBtn}" HorizontalAlignment="Right" Padding="0" Cursor="Hand"/>
                </DockPanel>

                <!-- Status Header Banner -->
                <Border x:Name="StatusBadgeBorder" Background="#163326" BorderBrush="#3FB68B" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock x:Name="TxtStatusBadge" Text="✔ SOLVED — OPTIMAL ARCHITECTURAL FIX" Foreground="#3FB68B" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtScoreHighlight" Text="+98.4 PTS" Foreground="#37D6E8" FontWeight="Bold" FontSize="16" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Attack Info -->
                <TextBlock x:Name="TxtAttackTitle" Text="Intrusion #18: Obfuscated Crash" Foreground="#E6EEF2" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                <!-- Metrics Grid -->
                <Border Background="#13232D" BorderBrush="#26404D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="PERFORMANCE, EFFICIENCY &amp; QUALITY METRICS" Foreground="#8AA0AC" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Functional Correctness:" Foreground="#8AA0AC" FontSize="12"/>
                                <TextBlock x:Name="TxtFunctionalPass" Text="✔ All Test Assertions Passed" Foreground="#3FB68B" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,8"/>

                                <TextBlock Text="Runtime Latency (P95):" Foreground="#8AA0AC" FontSize="12"/>
                                <TextBlock x:Name="TxtLatencyP95" Text="4.1 ms (Target: &lt;5.0 ms)" Foreground="#E6EEF2" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Peak Memory (RSS):" Foreground="#8AA0AC" FontSize="12"/>
                                <TextBlock x:Name="TxtMemoryUsage" Text="16.4 MB (Optimal)" Foreground="#E6EEF2" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,8"/>

                                <TextBlock Text="AI Prompts Used:" Foreground="#8AA0AC" FontSize="12"/>
                                <TextBlock x:Name="TxtPromptsUsed" Text="3 prompts (Efficient)" Foreground="#E6EEF2" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Score Breakdown -->
                <Border Background="#0E1E28" BorderBrush="#1F3947" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SCORE ITEMIZATION" Foreground="#8AA0AC" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Base Solution Points:" Foreground="#E6EEF2" FontSize="12"/>
                            <TextBlock x:Name="TxtBasePoints" Grid.Column="1" Text="+85.0 pts" Foreground="#E6EEF2" FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Optimization Multiplier:" Foreground="#E6EEF2" FontSize="12"/>
                            <TextBlock x:Name="TxtMultiplier" Grid.Column="1" Text="x 1.00" Foreground="#37D6E8" FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Speed Bonus (SLA Window):" Foreground="#E6EEF2" FontSize="12"/>
                            <TextBlock x:Name="TxtSpeedBonus" Grid.Column="1" Text="+13.4 pts" Foreground="#3FB68B" FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                        <Separator Background="#1F3947" Margin="0,6,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Net Awarded Score:" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="TxtNetScore" Grid.Column="1" Text="+98.4 PTS" Foreground="#37D6E8" FontWeight="Bold" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Evaluator Feedback -->
                <TextBlock Text="EVALUATOR TECHNICAL FEEDBACK:" Foreground="#8AA0AC" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <Border Background="#101C24" BorderBrush="#26404D" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,20">
                    <TextBlock x:Name="TxtFeedback" Text="Root cause patched cleanly. Response latency within municipal SLA targets." Foreground="#E6EEF2" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                </Border>

                <!-- Action Button -->
                <Button Content="DISMISS &amp; CONTINUE" Click="OnDismissClick"
                        Style="{StaticResource DialogPrimaryBtn}" Height="38" FontSize="13" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
