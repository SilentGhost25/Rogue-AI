<Window x:Class="LabKiosk.ComplianceLockoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compliance Review Lockout"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#E603070C"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="580" Height="400">
    <Window.Resources>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerBg" Color="#2A0B0B"/>
        <SolidColorBrush x:Key="CardBg" Color="#0B131B"/>
    </Window.Resources>

    <Border Background="#0F172A" BorderBrush="{StaticResource DangerRed}" BorderThickness="2" CornerRadius="8" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <DockPanel>
                    <Border Background="{StaticResource DangerBg}" BorderBrush="{StaticResource DangerRed}" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                        <TextBlock Text="🚨 DEFCON-1 COMPLIANCE VIOLATION" Foreground="{StaticResource DangerRed}" FontWeight="Bold" FontSize="11" FontFamily="Consolas"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDeskTag" Text="DESK-XX" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="BtnClose" Content="✕" Width="26" Height="26" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Click="OnCloseClick" ToolTip="Dismiss"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="Unauthorized Compute Tier Detected" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" Margin="0,14,0,4"/>
                <TextBlock Text="Your connected Google Account contains a Google AI Pro subscription." Foreground="#FCA5A5" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Content Card -->
            <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,14,0,14">
                <StackPanel VerticalAlignment="Center">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Account:" Foreground="#64748B" FontSize="12" Width="90"/>
                        <TextBlock x:Name="TxtEmail" Text="loading..." Foreground="#38BDF8" FontWeight="Bold" FontSize="12" FontFamily="Consolas"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Detected:" Foreground="#64748B" FontSize="12" Width="90"/>
                        <TextBlock x:Name="TxtTier" Text="Google AI Pro Subscription" Foreground="#F87171" FontWeight="Bold" FontSize="12"/>
                    </DockPanel>
                    <TextBlock Text="Competition regulations mandate standard Antigravity Starter / Gemini Free quota tiers to guarantee compute parity across all arena competitors."
                               Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Arbiter Status:" Foreground="#64748B" FontSize="12" Width="90"/>
                        <TextBlock x:Name="TxtArbiterStatus" Text="Alert transmitted. Awaiting Arbiter decision (Disqualify or Pardon)..." Foreground="#FBBF24" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ProgressBar x:Name="PrgSpin" IsIndeterminate="True" Height="4" Background="#1E293B" Foreground="{StaticResource DangerRed}" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Footer Note -->
            <DockPanel Grid.Row="2">
                <TextBlock x:Name="TxtFooter" Text="Competition regulations mandate free tier compute parity. You may switch accounts or request an organizer waiver." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="280"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnSwitchAccount" Content="Switch Account" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" Padding="10,5" Margin="0,0,8,0" Cursor="Hand" Click="OnSwitchAccountClick"/>
                    <Button x:Name="BtnDismiss" Content="Continue Defense" Background="#0F766E" Foreground="#FFFFFF" BorderThickness="0" Padding="12,5" Cursor="Hand" FontWeight="SemiBold" Click="OnDismissClick"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
