<Window x:Class="LabKiosk.ParticipantLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROGUE AI — Participant Arena Login"
        Height="500" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#0E1A22" Foreground="{StaticResource Ink}"
        BorderBrush="#FF4757" BorderThickness="1.5"
        ShowInTaskbar="True" WindowStyle="SingleBorderWindow" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Border Background="#1C1826" BorderBrush="#FF4757" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8">
                <TextBlock Text="THE BREACH PROTOCOL • DEFENSE ARENA" FontSize="10" FontWeight="Bold" Foreground="#FF4757"/>
            </Border>
            <TextBlock Text="Participant Terminal Login" FontWeight="Bold" FontSize="20" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="Identify your desk station and credentials to connect to Breach Command." FontSize="12" Foreground="{StaticResource Mute}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form Fields -->
        <StackPanel Grid.Row="1">
            <!-- Name -->
            <TextBlock Text="PARTICIPANT / TEAM NAME:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,5"/>
            <TextBox x:Name="ParticipantNameBox" Background="#070E13" Foreground="#FFFFFF" BorderBrush="{StaticResource Line}" Padding="8,6" FontSize="13" FontFamily="Segoe UI, sans-serif" Margin="0,0,0,14"/>

            <!-- Desk ID -->
            <TextBlock Text="DESK IDENTIFIER (e.g. DESK-01, DESK-02):" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,5"/>
            <TextBox x:Name="DeskIdBox" Background="#070E13" Foreground="#FFFFFF" BorderBrush="{StaticResource Line}" Padding="8,6" FontSize="13" FontFamily="Consolas, monospace" Margin="0,0,0,14"/>

            <!-- Password -->
            <TextBlock Text="ACCESS PASSWORD / EVENT PIN:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Background="#070E13" Foreground="#FFFFFF" BorderBrush="{StaticResource Line}" Padding="8,6" FontSize="13" Margin="0,0,0,14"/>

            <!-- Server URL with Auto-Discovery -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="BREACH COMMAND HOST URL:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="DiscoveryStatusText" Grid.Column="1" Text="🔍 Auto-detecting..." FontSize="10" Foreground="#1E90FF"/>
            </Grid>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerUrlBox" Grid.Column="0" Background="#070E13" Foreground="#2ED573" BorderBrush="{StaticResource Line}" Padding="8,6" FontSize="12" FontFamily="Consolas, monospace"/>
                <Button Grid.Column="1" Content="Scan LAN" Padding="10,4" Margin="6,0,0,0" Click="OnScanLan" Background="#162733" Foreground="#1E90FF" BorderBrush="#1E90FF" BorderThickness="1" FontSize="11"/>
            </Grid>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Exit" Padding="16,8" Click="OnCancel" Background="#1E3340" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}"/>
            <Button Grid.Column="1" Content="ENTER DEFENSE ARENA →" HorizontalAlignment="Right" Padding="20,8" Click="OnLogin" Background="#133826" Foreground="#2ED573" BorderBrush="#2ED573" BorderThickness="1.5" FontWeight="Bold" FontSize="13"/>
        </Grid>
    </Grid>
</Window>
