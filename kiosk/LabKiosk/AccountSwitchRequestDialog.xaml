<Window x:Class="LabKiosk.AccountSwitchRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Account Switch Request"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#D0050B10"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="540" Height="360">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandYellow" Color="#F59E0B"/>
        <SolidColorBrush x:Key="BrandBorder" Color="#334155"/>
        <SolidColorBrush x:Key="BrandCard" Color="#0B131B"/>
    </Window.Resources>

    <Border Background="#0E1722" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="8" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <DockPanel>
                    <Border Background="#2B1A04" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                        <TextBlock Text="ARBITER AUTHORIZATION REQUIRED" Foreground="#FBBF24" FontWeight="Bold" FontSize="11" FontFamily="Consolas"/>
                    </Border>
                    <TextBlock x:Name="TxtDeskTag" Text="DESK-XX" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Switch Google Account" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBlock Text="Switching Google credentials during the competition requires organizer approval." Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Status Box -->
            <Border Grid.Row="1" Background="{StaticResource BrandCard}" BorderBrush="{StaticResource BrandBorder}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,16" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Active Account:" Foreground="#64748B" FontSize="12" Width="110"/>
                        <TextBlock x:Name="TxtCurrentEmail" Text="loading..." Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" FontFamily="Consolas"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Request Status:" Foreground="#64748B" FontSize="12" Width="110"/>
                        <TextBlock x:Name="TxtStatus" Text="Transmitting request to Organizer Control Plane..." Foreground="#FBBF24" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ProgressBar x:Name="PrgSpin" IsIndeterminate="True" Height="4" Background="#1E293B" Foreground="#F59E0B" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Footer Actions -->
            <DockPanel Grid.Row="2">
                <TextBlock x:Name="TxtFeedback" Text="Standing by for organizer ruling..." Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                <Button x:Name="BtnCancel" Content="Cancel Request" HorizontalAlignment="Right" Click="OnCancelClick"
                        Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#475569" BorderThickness="1" Padding="16,8" Cursor="Hand" FontSize="12">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
