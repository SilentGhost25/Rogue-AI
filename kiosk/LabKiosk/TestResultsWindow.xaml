<Window x:Class="LabKiosk.TestResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Test Suite — Diagnostics"
        Height="540" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#0E1A22" Foreground="{StaticResource Ink}"
        BorderBrush="{StaticResource Line}" BorderThickness="1"
        ShowInTaskbar="False" WindowStyle="ToolWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadge" Background="{StaticResource Ok}" CornerRadius="4" Padding="10,5">
                        <TextBlock x:Name="StatusBadgeText" Text="✔ ALL TESTS PASSED" FontWeight="Bold" FontSize="12" Foreground="#0E1A22"/>
                    </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🧪 LOCAL TEST RUNNER (npm test)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="ExecutionDetailsText" Text="Executed in workspace" FontSize="11" Foreground="{StaticResource Mute}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Test Output Terminal-style Box -->
        <Border Grid.Row="1" Background="#070E13" Margin="14" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10">
            <TextBox x:Name="OutputBox" Background="Transparent" Foreground="#D5E1E8"
                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12.5"
                     BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#11202A" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="Tip: Passing local tests guarantees immunity against the -3.0 pt submission penalty." FontSize="11" Foreground="{StaticResource Mute}" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close (Esc)" Padding="18,6" Margin="8,0,0,0" Click="OnClose" Background="#1E3340" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
