<Window x:Class="LabKiosk.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Breach Protocol: Organizer Command Center" Width="1360" Height="860" Background="#0B141A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#0E1B23" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="True">
                <Button x:Name="CopyKey" DockPanel.Dock="Right" Content="Copy admin key" Padding="10,3" Margin="6,0,0,0" Click="OnCopyKey"/>
                <Button x:Name="OpenProjector" DockPanel.Dock="Right" Content="Open projector" Padding="10,3" Margin="6,0,0,0" Click="OnOpenProjector"/>
                <Button x:Name="OpenKiosk" DockPanel.Dock="Right" Content="💻 Open Participant View" Padding="10,3" Click="OnOpenKiosk"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Mute}" VerticalAlignment="Center" Text="Starting..."/>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Web" Grid.Row="1"/>
    </Grid>
</Window>
