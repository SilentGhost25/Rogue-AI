<Window x:Class="LabKiosk.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Breach Protocol - Organizer Command Center" Height="850" Width="1350"
        Background="#0B1319" Foreground="{StaticResource Ink}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Command Header -->
        <Border Grid.Row="0" Background="#111E28" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x1F4FA; Launch Stadium Projector" Padding="12,5" Margin="4,0" Background="#1E90FF" Foreground="#FFFFFF" FontWeight="Bold" Click="OnLaunchProjector"/>
                    <Button Content="&#x1F4BB; Open Participant View" Padding="12,5" Margin="4,0" Background="#1E3340" Foreground="{StaticResource Ink}" Click="OnOpenParticipantView"/>
                    <Button Content="&#x27F3; Reload" Padding="10,5" Margin="4,0" Background="#1E3340" Foreground="{StaticResource Ink}" Click="OnReload"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FF4757" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="ORGANIZER MODE" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock x:Name="ServerStatusText" Text="Control Plane: http://127.0.0.1:5080" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ok}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Embedded Web Control Center -->
        <wv2:WebView2 x:Name="AdminWeb" Grid.Row="1"/>
    </Grid>
</Window>
