<Window x:Class="LabKiosk.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

        xmlns:t="clr-namespace:LabKiosk.Terminal"

        xmlns:c="clr-namespace:LabKiosk.Controls"

        Title="ROGUE AI: The Breach Protocol" Background="#0A1218" Foreground="{StaticResource Ink}"

        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize" PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>

        <Style x:Key="DarkViewComboItem" TargetType="ComboBoxItem">

            <Setter Property="Background" Value="#0C161D"/>

            <Setter Property="Foreground" Value="{StaticResource Ink}"/>

            <Setter Property="Padding" Value="10,6"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">

                            <ContentPresenter VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#1D3544"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#22485C"/>

                                <Setter Property="FontWeight" Value="Bold"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="DarkViewCombo" TargetType="ComboBox">

            <Setter Property="Background" Value="#14242E"/>

            <Setter Property="Foreground" Value="{StaticResource Ink}"/>

            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="10,4"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkViewComboItem}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <ToggleButton x:Name="ToggleButton" Focusable="False"

                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"

                                          ClickMode="Press" Cursor="Hand">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border x:Name="bd" Background="#14242E" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,5">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Grid.Column="0"/>

                                                <TextBlock Grid.Column="1" Text="▾" Foreground="{StaticResource Cyan}" Margin="10,0,0,0" VerticalAlignment="Center"/>

                                            </Grid>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>

                                                <Setter TargetName="bd" Property="Background" Value="#1D3544"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"

                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"

                                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            </ToggleButton>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">

                                <Border Margin="0,2,0,0" Background="#0C161D" BorderBrush="{StaticResource Cyan}" BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}">

                                    <ScrollViewer SnapsToDevicePixels="True" MaxHeight="260">

                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="ViewBtn" TargetType="Button">

            <Setter Property="Background" Value="#14242E"/>

            <Setter Property="Foreground" Value="{StaticResource Ink}"/>

            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="9,4"/>

            <Setter Property="Margin" Value="2,0"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Cyan}"/>

                                <Setter TargetName="border" Property="Background" Value="#1D3544"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">

            <Setter Property="Background" Value="#1B3848"/>

            <Setter Property="Foreground" Value="#FFFFFF"/>

            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#255169"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SubmitBtn" TargetType="Button">

            <Setter Property="Background" Value="#13523B"/>

            <Setter Property="Foreground" Value="#FFFFFF"/>

            <Setter Property="BorderBrush" Value="{StaticResource Ok}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#1C7554"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="CyberTabRadio" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8FA3B0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="14,8" Margin="0,0,8,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#10202B"/>
                                <Setter Property="Foreground" Value="#D6E6F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#132635"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="52"/>   <!-- Top Command Strip -->

            <RowDefinition Height="34"/>   <!-- Live Attacks & Objectives Strip -->

            <RowDefinition Height="*"/>    <!-- Multi-pane Workspace -->

        </Grid.RowDefinitions>



        <!-- Top Header Strip -->

        <Border Grid.Row="0" Background="#09131B" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">

            <DockPanel Margin="14,0">

                <!-- Right Side Actions & Meters -->

                <Button x:Name="SubmitButton" DockPanel.Dock="Right" Content="⚡ Submit Fix (F5)" Padding="18,7" Margin="8,8"

                        Style="{StaticResource SubmitBtn}" Click="OnSubmitFix" AutomationProperties.Name="Submit fix"/>

                <Button x:Name="BtnProfile" DockPanel.Dock="Right" Content="👤 Profile" Padding="10,6" Margin="4,9"

                        Style="{StaticResource ActionBtn}" Click="OnProfileClick" ToolTip="Review participant identity &amp; accounts"/>

                <Button x:Name="AdminButton" DockPanel.Dock="Right" Content="⚙ Admin Console" Padding="10,6" Margin="4,9"

                        Style="{StaticResource ActionBtn}" Click="OnAdminConsole" AutomationProperties.Name="Open organizer console"/>

                <Border x:Name="DefenseLedBadge" DockPanel.Dock="Right" Visibility="Collapsed" Margin="6,9" Padding="10,4"
                        Background="#0D1F2D" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="DefenseLedTitle" Text="DEFENSE: " Foreground="{StaticResource Cyan}" FontSize="11" FontWeight="Bold" Margin="0,0,6,0"/>
                        <StackPanel x:Name="DefenseLedStrip" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DefenseLedPct" Text=" 100%" Foreground="{StaticResource Ok}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SolvedBadge" DockPanel.Dock="Right" Visibility="Collapsed" Margin="6,9" Padding="14,2"

                        Background="#143D31" BorderBrush="{StaticResource Ok}" BorderThickness="1" CornerRadius="4">

                    <Border.Effect><DropShadowEffect Color="#3FB68B" ShadowDepth="0" BlurRadius="10"/></Border.Effect>

                    <TextBlock Text="✔ SOLVED" Foreground="{StaticResource Ok}" FontWeight="Bold" VerticalAlignment="Center"/>

                </Border>

                <Border DockPanel.Dock="Right" Background="#0C1822" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="6,9">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AgyMeter" Text="✦ agy: ready" Foreground="{StaticResource Cyan}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock x:Name="OcMeter" Text="◈ OpenCode: 0 / 30" Foreground="{StaticResource Ink}"/>
                    </StackPanel>
                </Border>



                <!-- Center View Switcher: Compact Dropdown -->

                <ComboBox x:Name="ViewSelector" DockPanel.Dock="Right" Width="145" Margin="6,9" VerticalAlignment="Center"

                          Style="{StaticResource DarkViewCombo}" SelectedIndex="0" SelectionChanged="OnViewSelectionChanged"

                          ToolTip="Switch visible workspace panes">

                    <ComboBoxItem Content="⊞ All 3 Panes" Tag="All"/>

                    <ComboBoxItem Content="◫ Code + AI" Tag="CodeAi"/>

                    <ComboBoxItem Content="◫ Web + AI" Tag="WebAi"/>

                    <ComboBoxItem Content="◫ Web + Code" Tag="WebCode"/>

                    <ComboBoxItem Content="🌐 Web Only" Tag="Site"/>

                    <ComboBoxItem Content="💻 Code Only" Tag="Code"/>

                    <ComboBoxItem Content="🤖 AI Only" Tag="Ai"/>

                </ComboBox>



                <!-- Left: Status Display -->

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="ROGUE AI" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <Border Background="#0C1822" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="Starting..." Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Cursor="Hand" ToolTip="Click to change Organizer Server URL" MouseLeftButtonUp="OnStatusClick"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </DockPanel>

        </Border>



        <!-- Live Attacks & Objectives Strip -->

        <Border Grid.Row="1" Background="#0D1A22" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">

            <DockPanel Margin="14,0" VerticalAlignment="Center">

                <TextBlock Text="LIVE BREACH STATUS:" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="AttackBadgesPanel" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Populated dynamically: [ ⚡ #1 Defacement (ACTIVE) ] [ ✔ #2 XSS (SOLVED) ] -->

                        <TextBlock Text="Standing by. Waiting for event server..." Foreground="{StaticResource Mute}" FontSize="12" VerticalAlignment="Center"/>

                    </StackPanel>

                </ScrollViewer>

            </DockPanel>

        </Border>



        <!-- Main Workspace (Dynamic Split Layout) -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition x:Name="ColSite" Width="1.15*"/>

                <ColumnDefinition x:Name="Splitter1Col" Width="6"/>

                <ColumnDefinition x:Name="ColCode" Width="1.15*"/>

                <ColumnDefinition x:Name="Splitter2Col" Width="6"/>

                <ColumnDefinition x:Name="ColTerminal" Width="1.2*"/>

            </Grid.ColumnDefinitions>



            <!-- 1: the live website -->

            <wv2:WebView2 x:Name="Site" Grid.Column="0"/>

            <GridSplitter x:Name="Splitter1" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>



            <!-- 2: the code the agents are editing -->

            <c:CodeViewer x:Name="Code" Grid.Column="2"/>

            <GridSplitter x:Name="Splitter2" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>



            <!-- 3: real terminals -->

            <Grid x:Name="TerminalContainer" Grid.Column="4" Background="#070E13">

                <Grid.RowDefinitions>

                    <RowDefinition Height="38"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0C1822" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">

                    <DockPanel Margin="10,0">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <RadioButton x:Name="TabAgy" Style="{StaticResource CyberTabRadio}" Content="✦ Antigravity AI" GroupName="agent" IsChecked="True" Checked="OnTabChanged"/>

                            <RadioButton x:Name="TabOc" Style="{StaticResource CyberTabRadio}" Content="◈ OpenCode AI" GroupName="agent" Checked="OnTabChanged"/>

                        </StackPanel>

                        <Border DockPanel.Dock="Right" Background="#07121A" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="● CONPTY ISOLATED WORKSPACE" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
                        </Border>

                    </DockPanel>

                </Border>

                <Grid Grid.Row="1">

                    <t:TerminalTab x:Name="TermAgy"/>

                    <t:TerminalTab x:Name="TermOc" Visibility="Collapsed"/>

                </Grid>

            </Grid>

        </Grid>

        <!-- Full-Screen Participant Focus Tamper Lockout Overlay -->
        <Grid x:Name="FocusLockoutOverlay" Grid.Row="0" Grid.RowSpan="2"
              Panel.ZIndex="9999" Visibility="Collapsed" Background="#F0070E13">
            <Border Width="680" Background="#0C171F" BorderBrush="#E5533D" BorderThickness="2" CornerRadius="8"
                    Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#E5533D" BlurRadius="50" ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚨 " FontSize="22" VerticalAlignment="Center"/>
                            <TextBlock Text="DEFCON-1 COMPLIANCE LOCKOUT: FOCUS VIOLATION" Foreground="#E5533D" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Background="#1C1414" BorderBrush="#8A2626" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="STATION COMPROMISE: APPLICATION SWITCH OR WINDOW DEACTIVATION DETECTED"
                                       Foreground="#FF8577" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                            <TextBlock Text="In accordance with Breach Protocol competition regulations, switching windows, alt-tabbing, and background application usage are strictly prohibited. Your station has been frozen and terminals locked."
                                       Foreground="#E6EEF2" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>
                            <TextBlock x:Name="TxtFocusViolationReason" Text="Violation: App switch / Window focus loss"
                                       Foreground="#E0B341" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border Background="#0E1922" BorderBrush="#1F3647" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                <TextBlock Text="The Competition Arbiter has received an automated alert. Awaiting Arbiter decision (Pardon or Disqualification). Your station will unlock automatically once authorized."
                                           Foreground="#8AA0AC" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="● ARBITER LINK: " Foreground="#8AA0AC" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtFocusArbiterStatus" Text="ACTIVE · AWAITING DECISION" Foreground="#E0B341" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</Window>

