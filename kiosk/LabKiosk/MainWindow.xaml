<Window x:Class="LabKiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        xmlns:controls="clr-namespace:LabKiosk.Controls"
        Title="Breach Protocol - Defense Studio" Background="#0E1A22" Foreground="{StaticResource Ink}"
        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- fixed status strip: native-window controls block overlays -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status strip -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <Button x:Name="SubmitButton" DockPanel.Dock="Right" Content="Submit Fix (F5)" Padding="18,6" Margin="8,10,0,10"
                        Click="OnSubmitFix" AutomationProperties.Name="Submit fix" Background="{StaticResource Ok}" Foreground="#0E1A22" FontWeight="Bold"/>

                <Button x:Name="TestLocallyButton" DockPanel.Dock="Right" Content="🧪 Test Locally (F6)" Padding="14,6" Margin="10,10,4,10"
                        Click="OnTestLocally" AutomationProperties.Name="Test locally" Background="#163140" Foreground="#2ED573" BorderBrush="#2ED573" BorderThickness="1" FontWeight="SemiBold"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock x:Name="AgyMeter" Text="agy: ready" Margin="0,0,16,0" Foreground="{StaticResource Ok}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OcMeter" Text="OpenCode: 0 prompts" Foreground="{StaticResource Ink}"/>
                </StackPanel>

                <!-- Layout Toggle Buttons & Server Config -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Button Content="All 3" Padding="8,4" Margin="2,0" FontSize="11" Click="OnLayoutAll3" Background="#1E3340" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}"/>
                    <Button Content="Web+Term" Padding="8,4" Margin="2,0" FontSize="11" Click="OnLayoutWebTerm" Background="#1E3340" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}"/>
                    <Button Content="Code+Term" Padding="8,4" Margin="2,0" FontSize="11" Click="OnLayoutCodeTerm" Background="#1E3340" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}"/>
                    <Button Content="⚙ Server" Padding="8,4" Margin="6,0,2,0" FontSize="11" Click="OnServerConfigClicked" Background="#1E3340" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" ToolTip="Configure Organizer Server URL (Host IP)"/>
                </StackPanel>

                <!-- Verdict Celebration / Status Banner -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="VerdictBadge" Visibility="Collapsed" Background="{StaticResource Ok}" CornerRadius="3" Padding="8,2" Margin="0,0,12,0">
                        <TextBlock x:Name="VerdictBadgeText" Text="SOLVED" FontWeight="Bold" FontSize="12" Foreground="#0E1A22"/>
                    </Border>
                    <TextBlock x:Name="StatusText" Text="Starting..." VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main 3-Panel Workspace: Live Site | In-App Code Viewer | Real AI Terminal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColWeb" Width="1.1*"/>
                <ColumnDefinition x:Name="ColSplitter1" Width="6"/>
                <ColumnDefinition x:Name="ColCode" Width="1.2*"/>
                <ColumnDefinition x:Name="ColSplitter2" Width="6"/>
                <ColumnDefinition x:Name="ColTerm" Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Live Website (WebView2) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#11202A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,0">
                    <DockPanel VerticalAlignment="Center">
                        <Button DockPanel.Dock="Right" Content="⟳ Reload" Padding="8,2" FontSize="11" Click="OnReloadSite" Background="#1E3340" Foreground="{StaticResource Ink}" BorderThickness="0"/>
                        <TextBlock Text="LIVE WEBSITE (http://127.0.0.1:3000)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Mute}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <wv2:WebView2 x:Name="Site" Grid.Row="1"/>
            </Grid>

            <!-- Splitter 1 -->
            <GridSplitter x:Name="Splitter1" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

            <!-- Column 2: In-App Code Viewer & Editor -->
            <controls:CodeViewer x:Name="CodeView" Grid.Column="2"/>

            <!-- Splitter 2 -->
            <GridSplitter x:Name="Splitter2" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

            <!-- Column 4: Terminal Pane with ConPTY -->
            <Grid Grid.Column="4" Background="#0A1218">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#11202A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,0">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="TabAgy" Content="agy (Antigravity CLI)" GroupName="agent" IsChecked="True" Margin="0,0,16,0" Checked="OnTabChanged" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/>
                            <RadioButton x:Name="TabOpenCode" Content="OpenCode" GroupName="agent" Checked="OnTabChanged" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Dual ConPTY Terminal instances -->
                <Grid Grid.Row="1">
                    <term:EasyTerminalControl x:Name="AgyTerm" Visibility="Visible" Background="#0A1218" LogConPTYOutput="True" FontSizeWhenSettingTheme="13"/>
                    <term:EasyTerminalControl x:Name="OpenCodeTerm" Visibility="Collapsed" Background="#0A1218" LogConPTYOutput="True" FontSizeWhenSettingTheme="13"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
